# ─────────────────────────────────────────────────────────────
# Скопируйте этот файл в .env.local и заполните значения
# ─────────────────────────────────────────────────────────────

# Пароль для входа в скрытую админку по адресу /enter
ADMIN_PASSWORD=change-me-please

# Секрет для подписи сессионной cookie (любая длинная случайная строка).
# Сгенерировать: openssl rand -hex 32
AUTH_SECRET=please-generate-a-long-random-string

# Публичный логин в Telegram, куда пишут клиенты (без @).
# Используется как запасной вариант, если не задан в админке.
NEXT_PUBLIC_TELEGRAM_USERNAME=your_telegram

# ─────────────────────────────────────────────────────────────
# SEO: канонический адрес сайта (для sitemap.xml, robots.txt, Open Graph,
# JSON-LD). Запасной вариант, если адрес не задан в админке (/enter → Настройки).
# Пример: https://egefather.ru
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────
# Приём заявок из формы «Оставить заявку» → уведомление в Telegram
# ─────────────────────────────────────────────────────────────
# Токен бота от @BotFather (формат 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# ID чата/пользователя, куда бот присылает заявки.
# Узнать свой ID можно у бота @userinfobot; для канала/группы — числовой id
# (обычно начинается с -100...). Бот должен иметь право писать в этот чат.
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Автоответ клиенту на e-mail (необязательно).
# Если SMTP не настроен, автоответ просто не отправляется — приём заявок
# продолжает работать (заявка сохраняется в админке и уходит в Telegram).
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
# "true" для соединения по SSL (обычно порт 465), иначе оставьте пустым.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Адрес отправителя письма-автоответа (по умолчанию — SMTP_USER).
SMTP_FROM=
